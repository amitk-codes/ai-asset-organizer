# ---- Backend (api/) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# Gemini models — pin concrete, currently-served ids (avoid "-latest" aliases that
# can resolve to overloaded endpoints). Override here if a model gets deprecated.
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_ORGANIZE_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_MS=30000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend (web/) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# public base URL of the deployed site, used for share-link Open Graph previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
